# Copy to .env and fill in. .env is not tracked by git.

# --- Database ---
POSTGRES_USER=crypto
POSTGRES_PASSWORD=change_me
POSTGRES_DB=crypto_bot
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379

# --- Bybit ---
# Phase 1 does NOT NEED keys: every endpoint used is public.
# Filled in starting with Phase 5 (testnet).
# Key requirements: trading allowed, WITHDRAWALS FORBIDDEN, bound to IP.
BYBIT_API_KEY=
BYBIT_API_SECRET=
BYBIT_TESTNET=false

# --- Encryption ---
# Master key for encrypting exchange keys in the DB (Fernet).
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MASTER_KEY=

# --- Logs ---
LOG_LEVEL=INFO
LOG_FORMAT=console
